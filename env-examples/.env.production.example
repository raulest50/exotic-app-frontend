# Ejemplo: frontend publico de PRODUCCION mediante dominio en la VM.
# La web consume la API de produccion indicada abajo; no usar para staging.
#
# Los comentarios empiezan con # y no se interpretan como variables.
# Vite no carga esta carpeta ni el sufijo .example automaticamente.
# Para usar este ejemplo, ejecutar desde la raiz del repositorio frontend:
# bun --env-file=./env-examples/.env.production.example run vite build
#
# Las variables VITE_ quedan publicas en el JavaScript compilado (dist).
# Nunca agregar contrasenas, tokens privados ni credenciales a esta plantilla.
# Cambiar estas variables requiere volver a compilar el frontend.
# Para el artefacto SSH/localhost, omitir ambas variables al compilar.

# Entorno que identifica la aplicacion; debe corresponder a la API elegida.
VITE_APP_ENV=production

# URL base HTTPS del backend de produccion, sin credenciales ni query string.
VITE_API_BASE_URL=https://mrp.api.prod.exotic.com.co
